+// psemu patch: a descriptor dword loaded with s_buffer_load_dword* from a V# held in
+// user data (base pointer in sgprs r, r+1) at an immediate offset is the same read as
+// an s_load through that pointer, so it can be flattened like a ReadConst.
+// ReadConstBuffer insts whose V# is user-data sgprs (base_sgpr, base_sgpr+1,..) read at an
+// immediate dword; captured before PatchBufferSharp replaces the handle operand.
+struct CbufDword {
+    u32 base_sgpr;
+    u32 dword;
+};
+thread_local std::map<const IR::Inst*, CbufDword> g_cbuf_dwords;
+
+void CaptureCbufDwords(IR::Program& program) {
+    g_cbuf_dwords.clear();
+    for (IR::Block* const block : program.blocks) {
+        for (IR::Inst& inst : block->Instructions()) {
+            if (inst.GetOpcode() != IR::Opcode::ReadConstBuffer || inst.Arg(0).IsImmediate() ||
+                !inst.Arg(1).IsImmediate()) {
+                continue;
+            }
+            const IR::Inst* composite = inst.Arg(0).InstRecursive();
+            if (composite->NumArgs() < 2 || composite->Arg(0).IsImmediate() ||
+                composite->Arg(1).IsImmediate()) {
+                continue;
+            }
+            const IR::Inst* lo = composite->Arg(0).InstRecursive();
+            const IR::Inst* hi = composite->Arg(1).InstRecursive();
+            if (lo->GetOpcode() == IR::Opcode::GetUserData &&
+                hi->GetOpcode() == IR::Opcode::GetUserData &&
+                static_cast<u32>(hi->Arg(0).ScalarReg()) ==
+                    static_cast<u32>(lo->Arg(0).ScalarReg()) + 1) {
+                g_cbuf_dwords[&inst] = {static_cast<u32>(lo->Arg(0).ScalarReg()),
+                                        inst.Arg(1).U32()};
+            }
+        }
+    }
+}
+
+bool IsUdCbufSharpDword(const IR::Inst* inst) {
+    return inst->GetOpcode() == IR::Opcode::ReadConstBuffer && g_cbuf_dwords.contains(inst);
+}
